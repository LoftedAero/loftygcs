{
  "name": "lofty-gcs",
  "version": "0.9.1",
  "author": "Lofted Aero <info@loftedaero.com>",
  "description": "Lofty GCS — a modern cross-platform ground control station for ArduPilot",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoftedAero/loftygcs.git"
  },
  "homepage": "https://github.com/LoftedAero/loftygcs",
  "bugs": {
    "url": "https://github.com/LoftedAero/loftygcs/issues"
  },
  "keywords": [
    "ardupilot",
    "mavlink",
    "ground-control-station",
    "gcs",
    "drone",
    "uav",
    "electron",
    "web-serial"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "dist-electron/main.cjs",
  "type": "module",
  "//desktopName": "Top level, not under build.linux: electron-builder reads it from here for the .desktop file's StartupWMClass.",
  "desktopName": "lofty-gcs.desktop",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "package:web": "node scripts/package-web.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "cal-art": "electron scripts/make-cal-art.mjs",
    "dist": "npm run build:electron && electron-builder --publish never",
    "test": "vitest run",
    "sitl": "node scripts/sitl.mjs run",
    "sitl:fetch": "node scripts/sitl.mjs fetch",
    "video:testsrc": "node scripts/video-testsrc.mjs rtsp",
    "video:testsrc:udp": "node scripts/video-testsrc.mjs udp",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@mdi/js": "^7.4.47",
    "@tanstack/react-virtual": "^3.14.10",
    "cesium": "^1.145.0",
    "leaflet": "^1.9.4",
    "mavlink-mappings": "^1.0.22-20260311",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@testing-library/react": "^16.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^26.0.0",
    "node-mavlink": "^2.3.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.loftedaero.gcs",
    "productName": "Lofty GCS",
    "files": [
      "dist-electron/**/*",
      "dist-web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "menuCategory": "Lofted Aero",
      "uninstallDisplayName": "Lofty GCS",
      "artifactName": "LoftyGCS_${version}_windows_setup.${ext}"
    },
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "LoftyGCS_${version}_mac_${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "LoftyGCS_${version}_linux_${arch}.${ext}",
      "executableName": "lofty-gcs",
      "synopsis": "Ground control station for ArduPilot",
      "syncDesktopName": true
    },
    "deb": {
      "maintainer": "Lofted Aero <info@loftedaero.com>",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
